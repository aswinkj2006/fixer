# fixer.ai — Environment Configuration Template
# Copy this file to .env when setting up the project:
# cp .env.example .env

# ── SQLite Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./backend/database/fixer.db

# ── Chroma Vector Database ───────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db

# ── Local LLM (Ollama) Settings ──────────────────────────────────────────────
# When running on capable hardware (e.g., laptop with dedicated GPU / Apple Silicon):
# 1. Install Ollama from https://ollama.ai
# 2. Pull models:
#      ollama pull phi4-mini
#      ollama pull gemma3:4b
#      ollama pull nomic-embed-text
# 3. Set LLM_STUB_MODE=false below
OLLAMA_BASE_URL=http://localhost:11434
VISION_MODEL=gemma3:4b
REASONING_MODEL=phi4-mini
EMBEDDING_MODEL=nomic-embed-text

# ── LLM Stub Mode Toggle ─────────────────────────────────────────────────────
# Set to "true" during development on low-spec hardware (Intel i5/integrated graphics):
#   - Uses fast deterministic responses with REAL Chroma vector RAG retrieval
# Set to "false" when Ollama is running on capable hardware with GPU
LLM_STUB_MODE=true

# ── Slack Integration (Optional for live notifications) ──────────────────────
# Slack Bolt with Socket Mode requires NO public IP or ngrok.
# If you leave these blank, the app will run in offline mode (Slack calls logged to console).
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_ESCALATION_CHANNEL=C0C2R3H1VJA
SLACK_CHANNEL_ID=C0C2R3H1VJA
SLACK_TECHNICIAN_ID=U0C2LRFUGSX

# ── Sensor Simulation Settings ───────────────────────────────────────────────
# SIM_CLOCK_MULTIPLIER: time compression factor (600 = 10 mins simulated per real sec)
SIM_CLOCK_MULTIPLIER=600
# SIM_TICK_INTERVAL: physical tick cadence in seconds
SIM_TICK_INTERVAL=1.0

# ── Admin API Security ───────────────────────────────────────────────────────
# Secret key for anomaly injection routes (POST /api/admin/trigger)
ADMIN_SECRET_KEY=fixer-demo-key-2026

# ── CORS / Web Application ───────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
